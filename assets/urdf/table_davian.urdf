<?xml version="1.0"?>
<robot name="box">
  <link name="box">
    <visual>
      <material name="wood">
        <color rgba="0.82 0.56 0.35 1.0"/>
      </material>
      <origin xyz="0 -0.09 0"/>
      <geometry>
        <box size="0.9 0.9 0.3"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.09 0"/>
      <geometry>
        <box size="0.9 0.9 0.3"/>
      </geometry>
    </collision>
    <visual>
      <material name="plate">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
      <origin xyz="0 0.515 0"/>
      <geometry>
        <box size="0.25 0.25 0.3"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="500"/>
      <friction value="1.0"/>
      <inertia ixx="1000.0" ixy="0.0" ixz="0.0" iyy="1000.0" iyz="0.0" izz="1000.0"/>
    </inertial>
  </link>
</robot>
